networks:
    backend_net: # para isolar os serviços de backend
        driver: bridge
    frontend_net: # para isolar o frontend
        driver: bridge

services:
    banco:
        build:
            context: ./postgres
            dockerfile: Dockerfile
        container_name: banco_postgres
        image: banco_postgres_img:latest
        env_file:
            - .env
            - .env.prod
        # environment:
        #   POSTGRES_DB: ${POSTGRES_DB:-postgres}
        #   POSTGRES_USER: ${POSTGRES_USER:-postgres}
        #   POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
        ports:
            - "5432:5432"
        volumes:
            - ./postgres/data:/var/lib/postgresql/data
            - ./postgres/init-db.sh:/docker-entrypoint-initdb.d/init-db.sh:ro
            - ./postgres/logs:/var/log/postgresql
            - ./postgres/conf:/etc/postgresql-custom
            - ./.env:/docker-entrypoint-initdb.d/.env:ro
        networks:
            - backend_net
        restart: unless-stopped
        healthcheck:
            test:
                [
                    "CMD-SHELL",
                    "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres}",
                ]
            interval: 10s
            timeout: 5s
            retries: 5
        entrypoint: >
            sh -c "
            chown -R postgres:postgres /var/log/postgresql &&
            chmod -R 700 /var/log/postgresql &&
            exec docker-entrypoint.sh postgres
            -c logging_collector=on
            -c log_directory=/var/log/postgresql
            -c log_filename=postgresql.log
            -c log_file_mode=0666"

    storage:
        build:
            context: ./seaweedfs
            dockerfile: Dockerfile
        container_name: storage_seaweedfs
        image: storage_seaweedfs_img:latest
        env_file:
            - .env
            - .env.prod
        # environment:
        #   - TZ=America/Sao_Paulo
        #   - S3_ENDPOINT=http://storage:8333
        #   - POSTGRES_URL=banco
        ports:
            - "8333:8333" # S3 API
            - "9333:9333" # Painel Master
            - "8888:8888" # Filer API
        volumes:
            - ./seaweedfs/data:/data
        networks:
            - backend_net
        restart: unless-stopped
        healthcheck:
            test: ["CMD-SHELL", "curl -f http://localhost:8888/ || exit 1"]
            interval: 10s
            timeout: 5s
            retries: 5
        depends_on:
            banco:
                condition: service_healthy

    cache:
        build:
            context: ./redis
            dockerfile: Dockerfile
        container_name: cache_redis
        image: cache_redis_img:latest
        env_file:
            - .env
            - .env.prod
        ports:
            - "6379:6379"
        volumes:
            - ./redis/data:/data
            - ./redis/conf/redis.conf:/usr/local/etc/redis/redis.conf:ro
            - ./redis/logs:/var/log/redis
        networks:
            - backend_net
        restart: unless-stopped
        healthcheck:
            test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
            interval: 10s
            timeout: 5s
            retries: 5
        command: >
            redis-server /usr/local/etc/redis/redis.conf
            --requirepass ${REDIS_PASSWORD}

    cacheview:
        image: redis/redisinsight:latest
        container_name: redis_insight
        ports:
            - "5540:5540"
        volumes:
            - ./redisinsight/data:/data
        networks:
            - backend_net
        restart: unless-stopped

    biometria:
        build:
            context: ./facenet
            dockerfile: Dockerfile
            args:
                BIOMETRIA_USUARIO: ${BIOMETRIA_USUARIO:-appbiometria}
        container_name: biometria_facenet
        image: biometria_facenet_img:latest
        env_file:
            - .env
            - .env.prod
        # environment:
        #   - CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:--1}
        #   - DEEPFACE_HOME=/home/${BIOMETRIA_USUARIO:-appbiometria}
        #   - TF_CPP_MIN_LOG_LEVEL=${TF_CPP_MIN_LOG_LEVEL:-2}
        #   - TF_ENABLE_ONEDNN_OPTS=${TF_ENABLE_ONEDNN_OPTS:-0} # Para evitar warnings de otimização
        #   - TZ=America/Sao_Paulo # Mantém o fuso horário alinhado
        ports:
            - "8000:8000"
        volumes:
            - ./facenet/logs:/home/${BIOMETRIA_USUARIO:-appbiometria}/app/logs
            - ./facenet/weights:/home/${BIOMETRIA_USUARIO:-appbiometria}/.deepface/weights
        networks:
            - backend_net
        restart: unless-stopped
        healthcheck:
            test:
                ["CMD-SHELL", "curl -sf http://localhost:8000/health || exit 1"]
            interval: 15s
            timeout: 10s
            retries: 5
        depends_on:
            storage:
                condition: service_healthy

    iam:
        build:
            context: ./keycloak
            dockerfile: Dockerfile
        container_name: iam_keycloak
        image: iam_keycloak_img:latest
        env_file:
            - .env
            - .env.prod
        # environment:
        #   # TIPO DE BANCO: Mantido fixo pois define o driver interno do Keycloak
        #   KC_DB: postgres

        #   # CONEXÃO COM O BANCO
        #   KC_DB_URL: jdbc:postgresql://banco:5432/${KEYCLOAK_BD:-keycloak}
        #   KC_DB_USERNAME: ${KEYCLOAK_USU:-keycloak}
        #   KC_DB_PASSWORD: ${KEYCLOAK_SEN:-keycloak}

        #   # CREDENCIAIS DE ADMIN
        #   KC_BOOTSTRAP_ADMIN_USERNAME: ${KC_BOOTSTRAP_ADMIN_USERNAME:-admin}
        #   KC_BOOTSTRAP_ADMIN_PASSWORD: ${KC_BOOTSTRAP_ADMIN_PASSWORD:-admin}

        #   # PARAMETRIZAÇÕES DE AMBIENTE (RECOMENDADO)
        #   KC_HTTP_ENABLED: ${KC_HTTP_ENABLED:-true}
        #   KC_LOG_LEVEL: ${KC_LOG_LEVEL:-INFO}
        #   KC_ISSUER_URI: ${KC_ISSUER_URI:-http://${KC_HOSTNAME:-localhost:8080}/realms/corporativo}

        #   # CONFIGURAÇÕES ESTRUTURAIS DO CONTAINER (Podem ficar fixas)
        #   KC_HOSTNAME: localhost
        #   KC_HOSTNAME_STRICT: "false"
        #   KC_HTTP_RELATIVE_PATH: /
        #   KC_HOSTNAME_URL: http://localhost:8080
        #   KC_LOG: "console,file"
        #   KC_LOG_FILE: /opt/keycloak/logs/keycloak.log
        #   KC_METRICS_ENABLED: true
        #   KC_HEALTH_ENABLED: true
        ports:
            - "8080:8080"
        volumes:
            - ./keycloak/conf:/opt/keycloak/conf
            - ./keycloak/logs:/opt/keycloak/logs
            - ./keycloak/providers:/opt/keycloak/providers:ro
            - ./keycloak/themes:/opt/keycloak/themes:ro
        networks:
            - frontend_net
            - backend_net
        restart: unless-stopped
        healthcheck:
            test:
                [
                    "CMD-SHELL",
                    "curl -f http://localhost:8080/health/ready || exit 1",
                ]
            interval: 10s
            timeout: 5s
            retries: 5
        depends_on:
            banco:
                condition: service_healthy

    backend:
        build:
            context: ./backend
            dockerfile: Dockerfile
        container_name: backend_spring_java
        env_file:
            - .env
            - .env.prod
        ports:
            - "8081:8081"
        environment:
            - SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE:-prod}
        #   SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI: http://host.docker.internal:8080/realms/corporativo

        #   SPRING_DATASOURCE_URL: jdbc:postgresql://banco:5432/${BACKEND_BD:-backend}
        # extra_hosts:
        #   # Isso permite que o container 'backend' resolva 'host.docker.internal'
        #   # apontando para o IP do seu host (o Ubuntu)
        #   - "host.docker.internal:host-gateway"
        networks:
            - frontend_net
            - backend_net
        restart: unless-stopped
        depends_on:
            banco:
                condition: service_healthy
            storage:
                condition: service_healthy

    frontend-web:
        build:
            context: ./frontend-web
            dockerfile: Dockerfile
        container_name: frontend_web_reactjs
        image: frontend_web_img:latest
        env_file:
            - .env
            - .env.prod
        # environment:
        #   # O Vite exige que as variáveis comecem com VITE_ para expô-las ao navegador
        #   - VITE_API_BASE_URL=${VITE_API_BASE_URL}
        #   - VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
        ports:
            - "5173:5173"
        volumes:
            # Espelha a sua pasta local de código fonte para dentro do container (Hot Reload)
            - ./frontend-web:/app

            # [IMPORTANTE] Volume anônimo para proteger o node_modules
            # Isso impede que o node_modules compilado no seu Ubuntu sobrescreva
            # o node_modules do container (Alpine Linux), o que quebraria o Vite.
            - /app/node_modules
        networks:
            - frontend_net
        restart: unless-stopped
